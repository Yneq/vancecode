# Copy to .env in the directory where you launch VanceCode.
OPENAI_API_KEY=
# Choose a model available to your account that supports function calling.
VANCECODE_MODEL=
VANCECODE_BASE_URL=https://api.openai.com/v1
# Gemini alternative: OPENAI_API_KEY holds your Gemini key.
# VANCECODE_MODEL=gemini-3.6-flash
# VANCECODE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
